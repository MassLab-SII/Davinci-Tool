# EGTS model endpoints
EXPLORATION_MODEL_BASE_URL=https://your-exploration-endpoint/v1
EXPLORATION_MODEL_API_KEY=your_exploration_api_key_here
EXPLORATION_MODEL_NAME=your-exploration-model

JUDGE_MODEL_BASE_URL=https://your-judge-endpoint/v1
JUDGE_MODEL_API_KEY=your_judge_api_key_here
JUDGE_MODEL_NAME=your-judge-model

WRITER_MODEL_BASE_URL=https://your-writer-endpoint/v1
WRITER_MODEL_API_KEY=your_writer_api_key_here
WRITER_MODEL_NAME=your-writer-model

# MCPMark GitHub world
# GITHUB_TOKENS can contain one or more comma-separated fine-grained PATs.
GITHUB_TOKENS=github_pat_example
GITHUB_EVAL_ORG=mcpmark-eval-yourname

# Toolathlon world
# Optional: scripts/egts/run_toolathlon.sh auto-clones Toolathlon here when missing.
TOOLATHLON_ROOT=benchmarks/Toolathlon
TOOLATHLON_HOST_OUTPUT_ROOT=output/toolathlon_world
TOOLATHLON_AUTO_SETUP=1
TOOLATHLON_REPO_URL=https://github.com/hkust-nlp/Toolathlon.git
TOOLATHLON_REPO_REF=812bcd45bff0d1e5ad8b0d7d91206e55ab7453c0
TOOLATHLON_TASK_IMAGE=lockon0927/toolathlon-task-image:1016beta
TOOLATHLON_PULL_TASK_IMAGE=1

# Optional low-friction token-backed Toolathlon tasks.
# TOOLATHLON_GITHUB_TOKEN takes precedence; otherwise the runner falls back to
# GITHUB_TOKENS, GITHUB_TOKEN, or MCP_GITHUB_TOKEN.
TOOLATHLON_GITHUB_TOKEN=
TOOLATHLON_GITHUB_ALLOWED_REPOS=null
TOOLATHLON_GITHUB_READ_ONLY=1

# TOOLATHLON_HUGGINGFACE_TOKEN takes precedence; otherwise the runner falls back
# to HUGGINGFACE_TOKEN, HF_TOKEN, or HUGGING_FACE_HUB_TOKEN.
TOOLATHLON_HUGGINGFACE_TOKEN=

# EES (only for --context-mode/--judge-mode/--scenario-mode/--rollout-mode llm)
CROSS_DOMAIN_SCALING_API_KEY=
CROSS_DOMAIN_SCALING_BASE_URL=https://api.openai.com/v1
CROSS_DOMAIN_SCALING_MODEL=gpt-4.1-mini
CROSS_DOMAIN_SCALING_EMBEDDING_MODEL=text-embedding-3-large
CROSS_DOMAIN_SCALING_TIMEOUT_SECONDS=120

